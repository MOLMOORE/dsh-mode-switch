{
  "name": "dsh-mode-switch",
  "version": "0.3.0",
  "private": true,
  "description": "Tool profiles for DeepSeek Harness: choose which tools a session carries, edit profiles and their tool sets in the panel.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MOLMOORE/dsh-mode-switch.git"
  },
  "homepage": "https://github.com/MOLMOORE/dsh-mode-switch#readme",
  "bugs": {
    "url": "https://github.com/MOLMOORE/dsh-mode-switch/issues"
  },
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "catalog.js",
    "session-log.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "cordis-plugin",
    "tools",
    "tool-permissions",
    "tokens",
    "context-window",
    "preset"
  ],
  "scripts": {
    "test": "node test/gate.test.mjs"
  }
}
